<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.fitness.mapper.UserMapper">

    <resultMap id="UserResultMap" type="com.fitness.domain.User">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <resultMap id="UserProfileResultMap" type="com.fitness.domain.UserProfile">
        <id property="id" column="id"/>
        <result property="userId" column="user_id"/>
        <result property="fitnessLevel" column="fitness_level"/>
        <result property="goal" column="goal"/>
        <result property="daysPerWeek" column="days_per_week"/>
        <result property="availableEquipment" column="available_equipment"
                typeHandler="com.fitness.config.JsonbTypeHandler"/>
        <result property="weightKg" column="weight_kg"/>
        <result property="createdAt" column="created_at"/>
        <result property="updatedAt" column="updated_at"/>
    </resultMap>

    <select id="findUserByUsername" resultMap="UserResultMap">
        SELECT * FROM users WHERE username = #{username}
    </select>

    <select id="findUserById" resultMap="UserResultMap">
        SELECT * FROM users WHERE id = #{id}::uuid
    </select>

    <insert id="insertUser" parameterType="com.fitness.domain.User">
        INSERT INTO users (username, email, password_hash)
        VALUES (#{username}, #{email}, #{passwordHash})
    </insert>

    <select id="findProfileByUserId" resultMap="UserProfileResultMap">
        SELECT * FROM user_profiles
        WHERE user_id = #{userId}::uuid
        ORDER BY updated_at DESC
        LIMIT 1
    </select>

    <insert id="insertProfile" parameterType="com.fitness.domain.UserProfile">
        INSERT INTO user_profiles (
            user_id, fitness_level, goal, days_per_week, available_equipment, weight_kg
        ) VALUES (
            #{userId}::uuid,
            #{fitnessLevel}::fitness_level_enum,
            #{goal}::goal_enum,
            #{daysPerWeek},
            #{availableEquipment, typeHandler=com.fitness.config.JsonbTypeHandler}::jsonb,
            #{weightKg}
        )
    </insert>

    <update id="updateProfile" parameterType="com.fitness.domain.UserProfile">
        UPDATE user_profiles
        SET fitness_level = #{fitnessLevel}::fitness_level_enum,
            goal = #{goal}::goal_enum,
            days_per_week = #{daysPerWeek},
            available_equipment = #{availableEquipment, typeHandler=com.fitness.config.JsonbTypeHandler}::jsonb,
            weight_kg = #{weightKg}
        WHERE id = #{id}::uuid
    </update>

</mapper>
